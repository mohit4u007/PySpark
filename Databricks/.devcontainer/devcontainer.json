{
	"name": "Python Development",
	"image": "ghcr.io/metinsenturk/devcontainer-templates/simple-python:latest",
	"workspaceFolder": "/workspace",
	// "workspaceMount": "source=C:/Mohit/Active Study Material/Python/PySpark/Databricks/,target=/workspace,type=bind,consistency=cached",
	"mounts": [
		"source=C:/Mohit/Active Study Material/Python/PySpark/Databricks/,target=/workspace,type=bind,consistency=cached"
	],
	"remoteUser": "vscode",

	"postCreateCommand": "pip install --upgrade pip && pip install databricks-connect",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.isort",
				"ms-python.autopep8",
				"ms-python.mypy-type-checker",
				"ms-toolsai.jupyter",
				"databricks.databricks"
			]
		}
	}
}